### Variables
@apiVersion = /api/admin

###
### ============================================
### PROCESS ENDPOINTS - SHOW PROCESS
### ============================================
###

### Show Process - Success (Super Admin)
# @name showProcess
# Replace "process-slug-here" with the actual slug of the process
# Example: proceso-de-etica-medica-caso-001-pro-0001
GET {{base_url}}{{apiVersion}}/processes/process-slug-here
Accept: application/json
Authorization: Bearer {{auth_token}}

### Show Process - Success (Admin)
# @name showProcessAdmin
# Replace "process-slug-here" with the actual slug of the process
GET {{base_url}}{{apiVersion}}/processes/process-slug-here
Accept: application/json
Authorization: Bearer {{auth_token}}

### Show Process - Success (Secretary)
# @name showProcessSecretary
# Replace "process-slug-here" with the actual slug of the process
GET {{base_url}}{{apiVersion}}/processes/process-slug-here
Accept: application/json
Authorization: Bearer {{auth_token}}

### Show Process - Without Authentication
# Should return 401 Unauthorized
GET {{base_url}}{{apiVersion}}/processes/process-slug-here
Accept: application/json

### Show Process - Not Found (404)
# Should return 404 without JSON
GET {{base_url}}{{apiVersion}}/processes/non-existent-slug
Accept: application/json
Authorization: Bearer {{auth_token}}

